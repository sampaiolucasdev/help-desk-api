{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "lib/**/*.ts",
    "middlewares/**/*.ts",
    "modules/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
